# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Database Connection Pool Settings
DB_POOL_MAX=20                    # Maximum number of database connections
DB_POOL_IDLE_TIMEOUT=30000        # Milliseconds before idle connection closes
DB_POOL_TIMEOUT=5000              # Connection timeout in milliseconds

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Cache Configuration
L1_CACHE_SIZE=10000               # Maximum entries in L1 (in-memory) cache
L1_CACHE_TTL=60000                # L1 cache TTL in milliseconds (default 60s)

# Write Buffer Configuration
REDIS_FLUSH_INTERVAL=200          # Flush local buffer to Redis every N milliseconds
DB_BATCH_SIZE=1000                # Maximum batch size for database writes

# API Configuration
ORDER_ID_MAX=10_000               # Maximum order ID for random generation

# Performance & Monitoring
ENABLE_STATS=false                # Enable cache statistics logging (set to 'true' for dev)
